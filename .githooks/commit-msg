#!/bin/sh
# commit-msg hook: enforces Conventional Commits (https://www.conventionalcommits.org).
# Format: <type>[(scope)][!]: <description>   - see CONTRIBUTING.md.
# Enabled by scripts/setup-git.ps1 (core.hooksPath = .githooks).

msg_file="$1"

# first line that is neither a comment nor empty
subject=$(grep -v '^#' "$msg_file" | sed -n '/./{p;q}')

# messages generated by git itself are fine
case "$subject" in
  "Merge "* | "Revert \""* | "fixup! "* | "squash! "* | "amend! "*) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9][a-z0-9._/-]*\))?!?: [^ ].*$'

fail() {
  echo "" >&2
  echo "Commit message rejected: $1" >&2
  echo "" >&2
  echo "  Expected: <type>[(scope)][!]: <description>" >&2
  echo "  Types:    feat fix docs style refactor perf test build ci chore revert" >&2
  echo "  Example:  feat(boards): add multiple boards with overview and admin tabs" >&2
  echo "  Rules:    see CONTRIBUTING.md (subject <= 72 characters, blank line before the body)" >&2
  echo "" >&2
  exit 1
}

printf '%s\n' "$subject" | grep -Eq "$pattern" || fail "the first line is not in the Conventional Commits format"

[ "${#subject}" -le 72 ] || fail "the first line is longer than 72 characters (${#subject})"

# if there is a body, the second line must be blank
second=$(grep -v '^#' "$msg_file" | sed -n '2p')
[ -z "$second" ] || fail "the second line must be blank (subject and body are separated by an empty line)"

exit 0
